# ============================================================================
# Codio Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- JWT Authentication ---
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false

# --- Database ---
DB_PATH=codio_database.db

# --- Cache ---
CACHE_DIR=video_analysis_cache

# --- Piston Code Execution ---
PISTON_EXECUTE_URL=https://emkc.org/api/v2/piston/execute
PISTON_TIMEOUT_SECONDS=15

# --- Quiz ---
QUIZ_TOTAL_QUESTIONS=10

# --- yt-dlp (optional) ---
# YTDLP_COOKIE_FILE=cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
